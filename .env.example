# Neon settings. Without DATABASE_URL and Neon Auth the app runs in demo mode (pages saved in the browser).
DATABASE_URL=postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://ep-example.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=at-least-32-random-characters
# Product photos (Neon Object Storage, public "photos" bucket)
NEON_STORAGE_ENDPOINT=https://br-example.storage.ap-southeast-1.aws.neon.tech
NEON_STORAGE_REGION=ap-southeast-1
NEON_STORAGE_KEY_ID=
NEON_STORAGE_SECRET=
# Optional: AI copy drafts
ANTHROPIC_API_KEY=
