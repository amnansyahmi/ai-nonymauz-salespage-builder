# Connect an Upstash Redis database to this Vercel project (Production + Preview).
# Keep credentials on the server. Never paste them into the builder.
UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Optional AI copy drafting. Off until a model is explicitly selected.
# Use a current provider/model ID from your Vercel AI Gateway catalog.
AI_COPY_MODEL=
AI_GATEWAY_API_KEY=
# On Vercel, OIDC can authenticate instead of an API key.
