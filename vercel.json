{
  "functions": {
    "api/*.js": {
      "includeFiles": "js/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/p/:slug",
      "destination": "/api/site?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
